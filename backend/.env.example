# PMS admin token (the server owner's). Stored in Keychain as PLEX_TOKEN:
#   secret inject TELLY_PLEX_TOKEN=PLEX_TOKEN TELLY_TMDB_TOKEN=TMDB_READ_TOKEN --into backend/.env
TELLY_PLEX_TOKEN=
# TMDB v4 read access token (sent as Bearer)
TELLY_TMDB_TOKEN=
# plexbot ↔ Telly HMAC secret (same value in plex-agent's .env). Keychain: TELLY_SHARED_SECRET
TELLY_SHARED_SECRET=
# Overseerr API key (maps plexbot's web users → Plex). Keychain: OVERSEERR_API_KEY
TELLY_OVERSEERR_API_KEY=
# plexbot's Discord bot token, for alert DMs. NAS only; leave unset locally.
# TELLY_DISCORD_BOT_TOKEN=
# Optional overrides (defaults in config.py)
# TELLY_PUBLIC_URL=https://telly.chrisx.art
# TELLY_PLEX_URL=http://192.168.4.22:32400
# TELLY_DATABASE_URL=sqlite:///data/telly.db
